generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  photoUrl     String?
  createdAt    DateTime @default(now())

  account      Account?
  transactions Transaction[]
  consents     OpenFinanceConsent[]
  auditLogs    AuditLog[]
}

model Account {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0) @db.Decimal(15, 2)
  limit            Decimal  @default(2500) @db.Decimal(15, 2)
  debt             Decimal  @default(0) @db.Decimal(15, 2)
  creditScore      Int      @default(500)
  preApproved      Decimal  @default(0) @db.Decimal(15, 2)
  loansTotal       Decimal  @default(0) @db.Decimal(15, 2)
  estimatedIncome  Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt        DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creditor  String
  type      String
  value     Decimal  @db.Decimal(15, 2)
  status    String   @default("concluído")
  date      String
  createdAt DateTime @default(now())
}

// ─── Open Finance ──────────────────────────────────────────────────────────────

/// Catálogo de instituições financeiras parceiras
model Institution {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique   // ex: "deasbank", "banco-alpha"
  apiBaseUrl String              // URL base da API do banco externo
  logoUrl    String?
  active     Boolean  @default(true)
  canShareData       Boolean @default(true)   // pode ser fonte de dados
  canReceiveData     Boolean @default(true)   // pode receber dados
  canInitiatePayment Boolean @default(false)  // iniciação de pagamento
  createdAt  DateTime @default(now())

  consents   OpenFinanceConsent[]
}

/// Autorização concedida pelo usuário para compartilhar dados com uma instituição
model OpenFinanceConsent {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  /// pendente | ativo | revogado | expirado | erro
  status        String   @default("pendente")

  /// Token OAuth recebido do banco externo (armazenar criptografado em produção)
  accessToken   String?
  refreshToken  String?

  /// Código aleatório gerado antes do redirect OAuth para prevenir CSRF
  oauthState    String?

  /// Permissões concedidas pelo usuário: BALANCES_READ, TRANSACTIONS_READ, etc.
  permissions   String[]

  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  snapshots     OpenFinanceSnapshot[]
}

/// Snapshot dos dados financeiros recebidos de uma instituição em uma sincronização
model OpenFinanceSnapshot {
  id               String             @id @default(cuid())
  consentId        String
  consent          OpenFinanceConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  availableBalance Decimal @db.Decimal(15, 2)
  debt             Decimal @db.Decimal(15, 2)
  limit            Decimal @db.Decimal(15, 2)
  loans            Decimal @db.Decimal(15, 2)
  investments      Decimal @db.Decimal(15, 2)
  estimatedIncome  Decimal @db.Decimal(15, 2)
  externalScore    Int?

  /// Portabilidade salarial (separada dos dados de conta)
  requestedSalary  Decimal? @db.Decimal(15, 2)

  syncedAt         DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
}
